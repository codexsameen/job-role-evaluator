{
  "routes": [
    { "route": "/.auth/login/github", "allowedRoles": ["anonymous"] },
    { "route": "/login", "rewrite": "/login.html", "allowedRoles": ["anonymous"] },
    { "route": "/login.html",         "allowedRoles": ["anonymous"] },
    { "route": "/.auth/*",            "allowedRoles": ["anonymous"] },
    { "route": "/*",                  "allowedRoles": ["authenticated"] }
  ],
  "responseOverrides": {
    "401": { "redirect": "/login", "statusCode": 302 }
  },
  "globalHeaders": {
    "Cache-Control": "no-store"
  }
}
